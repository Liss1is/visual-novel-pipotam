label splashscreen:
    # Мгновенно экран черным
    scene black 
    with None
    
    show pipotam_team at truecenter
    with Dissolve(1.5)
    
    pause 3.0
    
    hide pipotam_team
    with Dissolve(1.0)
    
    return

